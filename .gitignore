# Dependencies
node_modules/
# NOTE: miniprogram/miniprogram_npm/ is the built npm output — it IS committed
# so clones render tdesign components without running "build npm".
# Unused components are stripped at upload time (ignoreUploadUnusedFiles: true).

# Build output
dist/

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Local env / secrets (never commit)
.env
.env.local
*.local
scripts/deploy.config.json
*.pem
private.key

# WeChat DevTools private config
project.private.config.json

# Per-function node_modules (common layer is synced, not installed per function)
cloudfunctions/*/node_modules/

# Coverage / test artifacts
coverage/
