# Dependencies
node_modules/

# Build output
dist/

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Local env / secrets (never commit)
.env
.env.local
*.local
scripts/deploy.config.json
*.pem
private.key

# WeChat DevTools private config
project.private.config.json

# Per-function node_modules (kernel is inlined at build time, not installed per function)
cloudfunctions/*/node_modules/

# Coverage / test artifacts
coverage/

# Android 壳工程构建产物与本地 SDK 配置（工程源码入库，产物可重建）
android/.gradle/
android/build/
android/app/build/
android/local.properties
# APK 交付物不入库（可执行 npm run build:apk 重建），避免仓库随二进制膨胀
out/
# Android 壳内嵌的 H5 产物由 `node scripts/build-apk.js` 自动同步，不入库
android/app/src/main/assets/www/
android/.v2c/
# 验证脚本的临时输出
uni-app/scripts/*.out.txt
# 测试专用转发桩（由 tests/bootstrap-source-shims 逻辑生成）
cloudfunctions/*/handlers/common-bundle.js
cloudfunctions/*/handlers/common-subscribe.js
