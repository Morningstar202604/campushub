# 服务端口
PORT=3000

# JWT 密钥（必改，生产用强随机值：openssl rand -hex 32）
JWT_SECRET=change-me

# 日志级别（pino：debug / info / warn / error；生产建议 info）
LOG_LEVEL=info

# PostgreSQL（唯一事实源：apps/server/prisma/schema.prisma，19 表）
DATABASE_URL=postgresql://campushub:campushub@localhost:5432/campushub

# 图片上传目录（可选扩展：切 OSS 时改为对象存储配置）
UPLOAD_DIR=./uploads
