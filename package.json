{
  "name": "campushub",
  "version": "0.9.5",
  "description": "CampusHub — An open-source campus & interest community for WeChat Mini Program + CloudBase",
  "engines": {
    "node": ">=16"
  },
  "license": "Apache-2.0",
  "author": "Morningstar202604",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/badhope/campushub.git"
  },
  "homepage": "https://gitcode.com/badhope/campushub",
  "bugs": {
    "url": "https://gitcode.com/badhope/campushub/issues"
  },
  "keywords": [
    "wechat-miniprogram",
    "wechat-cloud",
    "cloudbase",
    "community",
    "campus",
    "open-source"
  ],
  "scripts": {
    "build:mpm": "node -e \"console.log('前端已迁移至 uni-app/：小程序端请在 uni-app/ 下执行 npm run build:mp-weixin，产物 dist/build/mp-weixin 导入微信开发者工具。旧 miniprogram/ 客户端已于 v0.9.0 移除。')\"",
    "deploy": "node scripts/deploy.js --env prod",
    "deploy:dev": "node scripts/deploy.js --env dev",
    "doctor": "node scripts/doctor.js",
    "build:functions": "node scripts/build-functions.js",
    "build:functions:check": "node scripts/build-functions.js --check",
    "gen:gateways": "node scripts/gen-gateways.js",
    "gen:gateways:check": "node scripts/gen-gateways.js --check",
    "verify": "node scripts/verify-release.js",
    "contract": "node scripts/contract-check.js",
    "lint": "node scripts/ui-lint.js",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "format": "prettier --check \"cloudfunctions/**/*.js\" \"scripts/**/*.js\"",
    "format:fix": "prettier --write \"cloudfunctions/**/*.js\" \"scripts/**/*.js\"",
    "test": "node --test tests/*.test.js",
    "gate": "npm run gen:gateways:check && npm run build:functions && npm run build:functions:check && npm run contract && npm run lint:js && npm run format && npm test",
    "pretest": "node scripts/build-functions.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "miniprogram-ci": "^2.1.31",
    "prettier": "^3.6.2"
  }
}
