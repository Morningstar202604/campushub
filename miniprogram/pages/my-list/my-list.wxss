/* pages/my-list/my-list.wxss */
.my-list-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 16rpx;
}

.list-item {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.list-item:active {
  background: var(--color-bg-hover);
}

.item-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--color-bg-gray);
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  font-size: var(--font-size-base);
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 8rpx 0;
}
.item-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
}
.tag-task { background: var(--color-warning); color: var(--color-warning); }
.tag-resolved { background: #E6F6EC; color: var(--color-success); }
.tag-expired { background: #f0f0f0; color: #999; }

.item-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-price);
}

.item-time {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.load-more {
  padding: 32rpx 0;
  text-align: center;
}

.load-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

/* ===== 操作按钮（编辑/删除/取消收藏） ===== */
.item-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.item-edit {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  padding: 12rpx 16rpx;
}
.item-edit:active { opacity: 0.6; }
.item-delete {
  font-size: var(--font-size-sm);
  color: var(--color-danger);
  padding: 12rpx 16rpx;
}
.item-delete:active { opacity: 0.6; }

/* 分页提示 */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 32rpx 0;
}
.no-more-line {
  width: 80rpx;
  height: 1rpx;
  background: var(--color-border);
}
.no-more-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

/* 空状态 */
.empty-emoji { font-size: 96rpx; margin-bottom: 16rpx; }
.empty-sub {
  font-size: var(--font-size-sm);
  color: var(--color-text-placeholder);
  margin-top: 8rpx;
}
