/* pages/my-list/my-list.wxss */
.my-list-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 16rpx;
}

.list-item {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.list-item:active {
  background: var(--color-bg-hover);
}

.item-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--color-bg-gray);
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  font-size: var(--font-size-base);
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 8rpx 0;
}
.item-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
}
.tag-task { background: #fff4e6; color: #d97706; }
.tag-resolved { background: #e6f6ec; color: #16a34a; }
.tag-expired { background: #f0f0f0; color: #999; }

.item-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-price);
}

.item-time {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.load-more {
  padding: 32rpx 0;
  text-align: center;
}

.load-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
