<!-- pages/my-list/my-list.wxml -->
<view class="my-list-page">
  <view class="list" wx:if="{{list.length > 0}}">
    <view class="list-item" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" data-price="{{item.price}}" bindtap="onItemClick">
      <image wx:if="{{item.images[0]}}" src="{{item.images[0]}}" mode="aspectFill" class="item-thumb" />
      <view class="item-info">
        <view class="item-title ellipsis-2">{{item.title}}</view>
        <view class="item-meta">
          <text wx:if="{{item.price}}" class="item-price">¥{{item.price}}</text>
          <text class="item-time">{{item.timeText}}</text>
        </view>
      </view>
      <view
        class="item-delete"
        wx:if="{{type !== 'collects'}}"
        catchtap="onDelete"
        data-id="{{item._id}}"
        data-type="{{item.price !== undefined ? 'product' : 'post'}}"
      >删除</view>
    </view>
  </view>

  <view class="empty-container" wx:if="{{!loading && list.length === 0}}">
    <view class="empty-text">还没有内容</view>
  </view>

  <view class="load-more" wx:if="{{loading}}">
    <text class="load-text">加载中...</text>
  </view>
</view>
