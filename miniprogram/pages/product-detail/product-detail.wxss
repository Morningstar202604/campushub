/* pages/product-detail/product-detail.wxss */
.detail-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 140rpx;
}

/* 图片轮播 */
.image-swiper {
  width: 100%;
  height: 750rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 价格区 */
.price-section {
  background: #fff;
  padding: 32rpx;
}

.price-main {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.price-symbol {
  font-size: 32rpx;
  color: var(--color-price);
  font-weight: 600;
}

.price-value {
  font-size: 64rpx;
  color: var(--color-price);
  font-weight: 700;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  line-height: 1;
}

.price-original {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
  text-decoration: line-through;
}

.price-tags {
  display: flex;
  gap: 12rpx;
}

.price-tag {
  padding: 6rpx 20rpx;
  background: #FFF4E6;
  color: var(--color-warning);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 500;
}

/* 信息区 */
.info-section {
  background: #fff;
  padding: 32rpx;
  margin-top: 16rpx;
}

.product-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.product-desc {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.7;
  white-space: pre-wrap;
}

/* 卖家信息 */
.seller-section {
  background: #fff;
  padding: 32rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.seller-info {
  flex: 1;
}

.seller-name {
  font-size: var(--font-size-base);
  font-weight: 600;
}

.seller-meta {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

/* 交易信息 */
.trade-section {
  background: #fff;
  padding: 32rpx;
  margin-top: 16rpx;
}

.trade-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.trade-row:last-child {
  border-bottom: none;
}

.trade-label {
  width: 160rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
}

.trade-value {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

/* 安全提示 */
.safety-tip {
  margin: 16rpx 32rpx;
  padding: 24rpx;
  background: #FFF8E6;
  border-radius: var(--radius-md);
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.safety-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.safety-text {
  font-size: var(--font-size-sm);
  color: #8A6D3B;
  line-height: 1.5;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 99;
}

.bar-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
}

.bar-action.active .bar-icon {
  color: var(--color-warning);
}

.bar-icon {
  font-size: 36rpx;
}

.bar-text {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.bar-btn {
  flex: 1;
}

.loading-page {
  padding: 24rpx;
}
