/* 回到顶部 */
.back-top {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(30, 30, 30, 0.6);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* pages/wall/wall.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 16rpx 24rpx 180rpx;
}

.wall-tip {
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  padding: 12rpx 0 20rpx;
}

.card {
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
}

.card:active { transform: scale(0.99); }

.card-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.5;
}

.card-content {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-top: 10rpx;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
}

.card-time {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.card-stats { display: flex; gap: 24rpx; }

.stat {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 64rpx;
}

.empty-emoji { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: var(--font-size-md); color: var(--color-text-secondary); }
.empty-sub { font-size: var(--font-size-sm); color: var(--color-text-placeholder); margin-top: 8rpx; }

.load-more, .no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  z-index: 99;
}

.fab-icon { font-size: 44rpx; }
.fab:active { transform: scale(0.92); }
