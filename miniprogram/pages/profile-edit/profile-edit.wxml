<!-- pages/profile-edit/profile-edit.wxml -->
<view class="edit-page">
  <view class="form-section">
    <view class="form-label">昵称</view>
    <input class="form-input" placeholder="输入昵称" maxlength="20" value="{{nickname}}" bindinput="onNicknameInput" />
  </view>

  <view class="form-section">
    <view class="form-label">个人简介</view>
    <textarea class="form-textarea" placeholder="介绍一下自己吧" maxlength="100" value="{{bio}}" bindinput="onBioInput" auto-height />
  </view>

  <view class="form-section">
    <view class="form-label">学院</view>
    <input class="form-input" placeholder="如：文学与新闻传播学院" value="{{college}}" bindinput="onCollegeInput" />
  </view>

  <view class="form-section">
    <view class="form-label">专业</view>
    <input class="form-input" placeholder="如：汉语言文学" value="{{major}}" bindinput="onMajorInput" />
  </view>

  <view class="form-section">
    <view class="form-label">年级</view>
    <picker mode="selector" range="{{gradeOptions}}" bindchange="onGradeChange">
      <view class="form-picker {{grade ? '' : 'placeholder'}}">{{grade || '请选择年级'}}</view>
    </picker>
  </view>

  <view class="form-section">
    <view class="form-label">兴趣标签</view>
    <view class="tags-grid">
      <view class="tag-option {{selectedTags.includes(item) ? 'selected' : ''}}" wx:for="{{tagOptions}}" wx:key="*this" data-tag="{{item}}" bindtap="toggleTag">{{item}}</view>
    </view>
  </view>

  <view class="submit-bar safe-bottom">
    <t-button theme="primary" size="large" block bindtap="onSave" loading="{{saving}}">保存</t-button>
  </view>
</view>
