/* pages/profile-edit/profile-edit.wxss */
.edit-page {
  min-height: 100vh;
  background: #fff;
  padding: 0 32rpx 160rpx;
}

.form-section {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.form-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  height: 80rpx;
  font-size: var(--font-size-base);
}

.form-textarea {
  font-size: var(--font-size-base);
  min-height: 80rpx;
  width: 100%;
  line-height: 1.5;
}

.form-picker {
  height: 80rpx;
  font-size: var(--font-size-base);
  line-height: 80rpx;
}

.form-picker.placeholder {
  color: var(--color-text-placeholder);
}

.tags-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.tag-option {
  padding: 12rpx 28rpx;
  background: var(--color-bg-gray);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
}

.tag-option.selected {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.avatar-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-btn {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  background: var(--color-bg-gray);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.avatar-empty {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-placeholder);
}

/* 改名卡 */
.rename-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.rename-info {
  font-size: 22rpx;
  color: #6B7280;
}
.rename-btn {
  font-size: 24rpx;
  color: #4A90D9;
  background: rgba(74,144,217,0.08);
  border: 1rpx solid rgba(74,144,217,0.3);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
