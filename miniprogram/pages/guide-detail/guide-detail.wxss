/* pages/guide-detail/guide-detail.wxss */
.guide-detail-page {
  min-height: 100vh;
  background: #fff;
}

.cover-image {
  width: 100%;
}

.content-section {
  padding: 32rpx;
}

.guide-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.guide-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.meta-tag {
  font-size: var(--font-size-xs);
  background: var(--color-primary-bg);
  color: var(--color-primary);
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
}

.guide-stats {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.guide-content {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: 1.8;
}

.loading-page {
  padding: 32rpx;
}
