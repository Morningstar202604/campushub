/* 回到顶部 */
.back-top {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(30, 30, 30, 0.6);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* pages/lost-found/lost-found.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 16rpx 24rpx 200rpx;
}

.chips {
  display: flex;
  gap: 16rpx;
  padding-bottom: 20rpx;
}

.chip {
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.chip-active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

.card {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--color-bg-gray);
}

.card-body { flex: 1; overflow: hidden; }

.card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-kind {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  color: #fff;
}

.kind-lost { background: #e6a23c; }
.kind-found { background: var(--color-primary); }

.card-title {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-resolved {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--color-success, #67c23a);
}

.card-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.ellipsis-1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
}

.card-loc, .card-time {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 64rpx;
}
.empty-emoji { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: var(--font-size-md); color: var(--color-text-secondary); }
.empty-sub { font-size: var(--font-size-sm); color: var(--color-text-placeholder); margin-top: 8rpx; }

.load-more, .no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.fab-group {
  position: fixed;
  right: 32rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 99;
}

.fab {
  padding: 20rpx 32rpx;
  border-radius: var(--radius-full);
  color: #fff;
  font-size: var(--font-size-base);
  font-weight: 600;
  box-shadow: var(--shadow-float);
  text-align: center;
}

.fab:active { transform: scale(0.95); }

.fab-lost { background: #e6a23c; }
.fab-found { background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark)); }
