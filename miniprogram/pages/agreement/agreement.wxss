/* pages/agreement/agreement.wxss */
.agreement-page {
  min-height: 100vh;
  background: #fff;
  padding: 32rpx;
}

.agreement-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.agreement-date {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-bottom: 48rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.section-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.8;
}
