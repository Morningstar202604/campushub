/* pages/product-publish/product-publish.wxss */
.publish-page {
  min-height: 100vh;
  background: #fff;
  padding: 0 32rpx 160rpx;
}

.form-section {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.section-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 图片 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.cover-badge {
  position: absolute;
  top: 0;
  left: 0;
  background: var(--color-primary);
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 0 8rpx 0;
}

.image-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 56rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
}

.add-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* 输入 */
.title-input, .text-input {
  font-size: var(--font-size-md);
  font-weight: 500;
  padding: 16rpx 0;
}

.desc-input {
  font-size: var(--font-size-base);
  line-height: 1.6;
  min-height: 120rpx;
  width: 100%;
}

.char-count {
  text-align: right;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

/* 价格 */
.price-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.price-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.price-label {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  width: 160rpx;
}

.price-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-bg-gray);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  height: 80rpx;
}

.price-symbol {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-price);
  margin-right: 8rpx;
}

.price-input {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-price);
}

/* 分类网格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  padding: 16rpx 32rpx;
  background: var(--color-bg-gray);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.category-item.active {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
  color: var(--color-primary);
  font-weight: 500;
}

/* 提示 */
.form-tip {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
  line-height: 1.5;
}

/* 提交 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 99;
}
