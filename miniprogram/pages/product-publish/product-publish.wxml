<!-- pages/product-publish/product-publish.wxml -->
<view class="publish-page">
  <!-- 图片 -->
  <view class="form-section">
    <view class="section-label">商品图片（1-9张，第一张为封面）</view>
    <view class="image-grid">
      <view class="image-item" wx:for="{{images}}" wx:key="*this" wx:for-index="idx">
        <image src="{{item}}" mode="aspectFill" class="preview-image" data-index="{{idx}}" bindtap="previewImage" />
        <view class="cover-badge" wx:if="{{idx === 0}}">封面</view>
        <view class="image-delete" data-index="{{idx}}" catchtap="removeImage">×</view>
      </view>
      <view class="image-add" wx:if="{{images.length < 9}}" bindtap="chooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">{{images.length}}/9</text>
      </view>
    </view>
  </view>

  <!-- 标题 -->
  <view class="form-section">
    <input 
      class="title-input" 
      placeholder="商品标题（如：九成新iPad Air 4代）" 
      maxlength="30"
      value="{{title}}"
      bindinput="onTitleInput"
    />
  </view>

  <!-- 描述 -->
  <view class="form-section">
    <textarea
      class="desc-input"
      placeholder="描述商品成色、使用时间、转手原因等..."
      maxlength="500"
      value="{{description}}"
      bindinput="onDescInput"
      auto-height
    />
    <view class="char-count">{{description.length}}/500</view>
  </view>

  <!-- 价格 -->
  <view class="form-section price-section">
    <view class="price-row">
      <text class="price-label">售价</text>
      <view class="price-input-wrap">
        <text class="price-symbol">¥</text>
        <input 
          class="price-input" 
          type="digit"
          placeholder="0.00"
          value="{{price}}"
          bindinput="onPriceInput"
        />
      </view>
    </view>
    <view class="price-row">
      <text class="price-label">原价（选填）</text>
      <view class="price-input-wrap">
        <text class="price-symbol">¥</text>
        <input 
          class="price-input" 
          type="digit"
          placeholder="0.00"
          value="{{originalPrice}}"
          bindinput="onOriginalPriceInput"
        />
      </view>
    </view>
  </view>

  <!-- 分类 -->
  <view class="form-section">
    <view class="section-label">分类</view>
    <view class="category-grid">
      <view 
        class="category-item {{category === item.value ? 'active' : ''}}" 
        wx:for="{{categories}}" 
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onCategoryChange"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 成色 -->
  <view class="form-section">
    <view class="section-label">成色</view>
    <view class="category-grid">
      <view 
        class="category-item {{condition === item.value ? 'active' : ''}}" 
        wx:for="{{conditions}}" 
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onConditionChange"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 交易方式 -->
  <view class="form-section">
    <view class="section-label">交易方式</view>
    <view class="category-grid">
      <view 
        class="category-item {{tradeType === item.value ? 'active' : ''}}" 
        wx:for="{{tradeTypes}}" 
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onTradeTypeChange"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 交易地点 -->
  <view class="form-section" wx:if="{{tradeType === 'face'}}">
    <input 
      class="text-input" 
      placeholder="交易地点（如：东区食堂门口）" 
      maxlength="50"
      value="{{location}}"
      bindinput="onLocationInput"
    />
  </view>

  <!-- 联系方式 -->
  <view class="form-section">
    <input 
      class="text-input" 
      placeholder="联系方式（微信号/QQ号，选填）" 
      maxlength="30"
      value="{{contactInfo}}"
      bindinput="onContactInput"
    />
    <view class="form-tip">💡 仅发布信息展示，平台不参与交易，请线下自行交易</view>
  </view>

  <!-- 提交 -->
  <view class="submit-bar safe-bottom">
    <t-button theme="primary" size="large" block bindtap="submit" loading="{{submitting}}">
      {{isEdit ? '保存修改' : '发布商品'}}
    </t-button>
  </view>
</view>
