/* pages/post-detail/post-detail.wxss */
.detail-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 120rpx;
}

/* 帖子区 */
.post-section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

/* 作者栏 */
.author-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.author-avatar, .comment-avatar {
  flex-shrink: 0;
}

.avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.author-info {
  flex: 1;
}

.author-name {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text-primary);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.anon-badge {
  font-size: 18rpx;
  background: #F0F0F0;
  color: var(--color-text-tertiary);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  font-weight: 400;
}

.author-meta {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.category-badge {
  font-size: var(--font-size-xs);
  background: var(--color-primary-bg);
  color: var(--color-primary);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
}

/* 标题 */
.post-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.4;
  margin-bottom: 16rpx;
}

/* 正文 */
.post-content {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: 1.7;
  margin-bottom: 24rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 图片 */
.post-images {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.post-image {
  width: 100%;
  border-radius: var(--radius-md);
}

/* 标签 */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

/* 互动栏 */
.action-bar {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  transition: all 0.2s;
}

.action-item:active {
  background: var(--color-bg-hover);
}

.action-item.active {
  color: var(--color-primary);
}

.action-icon {
  font-size: 32rpx;
}

.action-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.action-item.active .action-text {
  color: var(--color-primary);
  font-weight: 500;
}

/* 评论区 */
.comment-section {
  background: #fff;
  padding: 32rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 评论项 */
.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar .avatar-img,
.comment-avatar .avatar-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.comment-avatar .avatar-placeholder {
  font-size: 24rpx;
}

.comment-body {
  flex: 1;
}

.comment-name {
  font-size: var(--font-size-sm);
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.comment-text {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: 1.5;
}

.comment-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

.comment-time {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.comment-reply {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
}

.reply-notice {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

/* 空评论 */
.empty-comment {
  padding: 64rpx 0;
  text-align: center;
}

.empty-comment-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

/* 底部输入栏 */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 99;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-bg-gray);
  border-radius: var(--radius-full);
  padding: 0 28rpx;
  font-size: var(--font-size-base);
}

.send-btn {
  padding: 16rpx 32rpx;
  background: var(--color-bg-gray);
  color: var(--color-text-tertiary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-base);
  font-weight: 500;
  transition: all 0.2s;
}

.send-btn.active {
  background: var(--color-primary);
  color: #fff;
}

/* 加载 */
.loading-page {
  padding: 32rpx;
}
