<!-- pages/post-detail/post-detail.wxml -->
<view class="detail-page" wx:if="{{post}}">
  <!-- 帖子内容 -->
  <view class="post-section">
    <!-- 作者信息 -->
    <view class="author-bar">
      <view class="author-avatar" bindtap="goUserProfile">
        <image wx:if="{{post.userAvatar}}" src="{{post.userAvatar}}" class="avatar-img" />
        <view wx:else class="avatar-placeholder">{{post.userNicknameFirst || '匿'}}</view>
      </view>
      <view class="author-info" bindtap="goUserProfile">
        <view class="author-name">
          {{post.userNickname}}
      <text class="author-v" wx:if="{{post.authorVerified}}">🎖️ 已认证</text>
          <text class="anon-badge" wx:if="{{post.isAnonymous}}">匿名</text>
        </view>
        <view class="author-meta">{{formatCreateTime}}</view>
      </view>
      <!-- 关注按钮（非作者时显示） -->
      <view class="follow-btn {{isFollowing ? 'following' : ''}}" wx:if="{{!canDelete && !post.isAnonymous}}" catchtap="onFollow">
        {{isFollowing ? '已关注' : '+ 关注'}}
      </view>
      <view class="category-badge">{{categoryText}}</view>
      <view class="status-badge task" wx:if="{{post.location}}">📍{{post.location}}</view>
      <view class="status-badges">
        <text class="status-badge task" wx:if="{{isTask}}">📌 任务</text>
        <text class="status-badge resolved" wx:if="{{isResolved}}">✅ 已解决</text>
        <text class="status-badge expired" wx:if="{{isExpired}}">⏰ 已过期</text>
      </view>
    </view>

    <!-- 标题 -->
    <view class="post-title">{{post.title}}</view>

    <!-- 正文 -->
    <view class="post-content" wx:if="{{post.content}}">{{post.content}}</view>

    <!-- 图片 -->
    <view class="post-images" wx:if="{{post.images.length > 0}}">
      <image 
        wx:for="{{post.images}}" 
        wx:key="*this"
        src="{{item}}" 
        mode="widthFix"
        class="post-image"
        data-index="{{index}}"
        bindtap="previewImage"
        lazy-load
      />
    </view>

    <!-- 标签 -->
    <view class="post-tags" wx:if="{{post.tags.length > 0}}">
      <view class="tag tag-primary" wx:for="{{post.tags}}" wx:key="*this">#{{item}}</view>
    </view>

    <!-- 互动栏 -->
    <view class="action-bar">
      <view class="action-item" wx:if="{{post.viewCount !== undefined}}">
        <text class="action-icon">👁</text>
        <text class="action-text">{{post.viewCount || 0}}</text>
      </view>
      <view class="action-item {{isLiked ? 'active' : ''}}" data-type="post" bindtap="onLike">
        <text class="action-icon">{{isLiked ? '❤️' : '🤍'}}</text>
        <text class="action-text">{{post.likeCount || 0}}</text>
      </view>
      <view class="action-item" bindtap="scrollToComment">
        <text class="action-icon">💬</text>
        <text class="action-text">{{post.commentCount || 0}}</text>
      </view>
      <view class="action-item {{isCollected ? 'active' : ''}}" bindtap="onCollect">
        <text class="action-icon">{{isCollected ? '⭐' : '☆'}}</text>
        <text class="action-text">{{post.collectCount || 0}}</text>
      </view>
      <view class="action-item" bindtap="onShare">
        <text class="action-icon">↗</text>
        <text class="action-text">分享</text>
      </view>
      <view class="action-item" wx:if="{{canEdit}}" bindtap="onEdit">
        <text class="action-icon">✏️</text>
        <text class="action-text">编辑</text>
      </view>
      <view class="action-item" wx:if="{{canDelete}}" bindtap="onDeletePost">
        <text class="action-icon">🗑️</text>
        <text class="action-text">删除</text>
      </view>
      <view class="action-item resolve" wx:if="{{canResolve}}" bindtap="onResolve">
        <text class="action-icon">✅</text>
        <text class="action-text">{{isTask ? '解决' : '完成'}}</text>
      </view>
      <view class="action-item" wx:if="{{!canDelete}}" bindtap="onReport">
        <text class="action-icon">🚩</text>
        <text class="action-text">举报</text>
      </view>
    </view>
  </view>

  <!-- 评论区（楼中楼） -->
  <view class="comment-section" id="comment-section">
    <view class="section-header">
      <text class="section-title">评论 {{post.commentCount || 0}}</text>
    </view>

    <!-- 评论列表（楼中楼） -->
    <view class="comment-list" wx:if="{{comments.length > 0}}">
      <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
        <view class="comment-avatar">
          <image wx:if="{{item.userAvatar}}" src="{{item.userAvatar}}" class="avatar-img" />
          <view wx:else class="avatar-placeholder">{{item.userNicknameFirst || '匿'}}</view>
        </view>
        <view class="comment-body">
          <view class="comment-name">{{item.userNickname}}</view>
          <view class="comment-text">{{item.content}}</view>
          <view class="comment-meta">
            <text class="comment-time">{{item.timeText}}</text>
            <text class="comment-action" data-userid="{{item.userId}}" data-nickname="{{item.userNickname}}" data-commentid="{{item._id}}" bindtap="onReply">回复</text>
            <text class="comment-action {{item.liked ? 'liked' : ''}}" data-id="{{item._id}}" data-liked="{{item.liked}}" catchtap="onCommentLike">
              {{item.liked ? '❤️' : '🤍'}} {{item.likeCount || 0}}
            </text>
            <text class="comment-delete" wx:if="{{item.userId === currentUserId}}" data-id="{{item._id}}" bindtap="onDeleteComment">删除</text>
          </view>

          <!-- 楼中楼子回复：≤2 条直接展示；更多时默认折叠、可展开 -->
          <view class="sub-replies" wx:if="{{item.replies.length > 0 && (item.replies.length <= 2 || expandedReplies[item._id])}}">
            <view class="reply-item" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="_id">
              <text class="reply-name">{{reply.userNickname}}</text>
              <text class="reply-arrow" wx:if="{{reply.replyToNickname}}"> 回复 @{{reply.replyToNickname}}</text>
              <text class="reply-arrow" wx:else>: </text>
              <text class="reply-text">{{reply.content}}</text>
              <view class="reply-meta">
                <text class="reply-time">{{reply.timeText}}</text>
                <text class="comment-action" data-userid="{{reply.userId}}" data-nickname="{{reply.userNickname}}" data-commentid="{{item._id}}" catchtap="onReply">回复</text>
                <text class="comment-action {{reply.liked ? 'liked' : ''}}" data-id="{{reply._id}}" data-liked="{{reply.liked}}" catchtap="onCommentLike">
                  {{reply.liked ? '❤️' : '🤍'}} {{reply.likeCount || 0}}
                </text>
                <text class="comment-delete" wx:if="{{reply.userId === currentUserId}}" data-id="{{reply._id}}" catchtap="onDeleteComment">删除</text>
              </view>
            </view>
          </view>

          <!-- 展开/折叠子回复（仅多于 2 条时显示，点击真实生效） -->
          <view class="toggle-replies" wx:if="{{item.replies.length > 2}}" data-id="{{item._id}}" bindtap="toggleReplies">
            {{expandedReplies[item._id] ? '收起' : '展开'}} {{item.replies.length}}条回复
          </view>
        </view>
      </view>
    </view>

    <!-- 空评论 -->
    <view class="empty-comment" wx:else>
      <text class="empty-comment-text">还没有评论，快来抢沙发</text>
    </view>
  </view>

  <!-- 底部输入栏 -->
  <view class="input-bar safe-bottom">
    <view class="reply-hint" wx:if="{{replyTo}}" catchtap="cancelReply">
      回复 @{{replyTo}} ✕
    </view>
    <view class="input-row">
      <input 
        class="comment-input" 
        placeholder="{{replyTo ? '回复 @' + replyTo + '...' : '写评论...'}}" 
        value="{{commentText}}"
        bindinput="onCommentInput"
        confirm-type="send"
        bindconfirm="sendComment"
        cursor-spacing="20"
        adjust-position="{{true}}"
      />
      <view class="send-btn {{commentText ? 'active' : ''}}" bindtap="sendComment">发送</view>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading-page" wx:if="{{!post && loading}}">
  <view class="skeleton-block" style="height: 200rpx; margin-bottom: 32rpx;"></view>
  <view class="skeleton-block" style="height: 400rpx; margin-bottom: 32rpx;"></view>
  <view class="skeleton-block" style="height: 300rpx;"></view>
</view>

<!-- 加载失败 -->
<view class="empty-container" wx:if="{{!post && !loading}}">
  <view class="empty-emoji">😕</view>
  <view class="empty-text">帖子不存在或已被删除</view>
</view>
