<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 顶部搜索栏（非自定义导航栏，tabBar页面用系统导航栏） -->
  <view class="top-bar">
    <view class="top-title">CampusHub</view>
    <view class="top-search" bindtap="goSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索帖子、商品、指南</text>
    </view>
    <view class="top-expired" bindtap="goExpired">⏰过期</view>
    <view class="top-expired" bindtap="goWall">💌墙</view>
  </view>

  <!-- 公告条（运营公告，置顶优先，最多展示 3 条） -->
  <view class="announcement-bar" wx:if="{{announcements.length > 0}}">
    <view class="announcement-item" wx:for="{{announcements}}" wx:key="_id" data-index="{{index}}" bindtap="onAnnouncementTap">
      <text class="announcement-tag">📢</text>
      <text class="announcement-title">{{item.title}}</text>
      <text class="announcement-more">详情</text>
    </view>
  </view>

  <!-- 分类筛选条（多级目录） -->
  <view class="cat-filter" bindtap="onCategoryTap">
    <text class="cat-filter-icon">📂</text>
    <text wx:if="{{selectedCategoryName}}" class="cat-filter-text">{{selectedCategoryName}}</text>
    <text wx:else class="cat-filter-text cat-filter-placeholder">全部分类</text>
    <text wx:if="{{selectedCategoryId}}" class="cat-filter-clear" catchtap="clearCategory">✕ 清除</text>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view 
      class="tab-item {{activeTab === item.key ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >
      <text class="tab-text">{{item.name}}</text>
      <view class="tab-line" wx:if="{{activeTab === item.key}}"></view>
    </view>
  </view>

  <!-- 信息流瀑布流 -->
  <view class="feed" wx:if="{{leftList.length > 0 || rightList.length > 0}}">
    <!-- 左列 -->
    <view class="feed-col">
      <block wx:for="{{leftList}}" wx:key="_id">
        <!-- 帖子卡片 -->
        <view class="feed-card" data-id="{{item._id}}" bindtap="onPostTap">
          <image
            wx:if="{{item.images.length > 0}}"
            src="{{item.images[0]}}"
            mode="widthFix"
            class="card-cover"
            lazy-load
          />
          <view class="card-body">
            <view class="card-pin-badge" wx:if="{{item.isPinned}}">📌 置顶</view>
            <view class="card-title ellipsis-2">{{item.title}}</view>
            <view class="card-desc ellipsis-2" wx:if="{{item.content}}">{{item.content}}</view>
            <view class="card-tags" wx:if="{{item.tags.length > 0}}">
              <view class="tag tag-primary" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</view>
            </view>
            <view class="card-meta">
              <view class="meta-user">
                <image wx:if="{{item.userAvatar}}" src="{{item.userAvatar}}" class="meta-avatar" />
                <view class="meta-avatar-placeholder" wx:else>{{item.userNicknameFirst || '匿'}}</view>
                <text class="meta-name">{{item.userNickname}}</text>
                <text class="meta-v" wx:if="{{item.authorVerified}}">✓</text>
              </view>
              <text class="meta-stat">❤ {{item.likeCount || 0}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
    
    <!-- 右列 -->
    <view class="feed-col">
      <block wx:for="{{rightList}}" wx:key="_id">
        <view class="feed-card" data-id="{{item._id}}" bindtap="onPostTap">
          <image
            wx:if="{{item.images.length > 0}}"
            src="{{item.images[0]}}"
            mode="widthFix"
            class="card-cover"
            lazy-load
          />
          <view class="card-body">
            <view class="card-pin-badge" wx:if="{{item.isPinned}}">📌 置顶</view>
            <view class="card-title ellipsis-2">{{item.title}}</view>
            <view class="card-desc ellipsis-2" wx:if="{{item.content}}">{{item.content}}</view>
            <view class="card-tags" wx:if="{{item.tags.length > 0}}">
              <view class="tag tag-primary" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</view>
            </view>
            <view class="card-meta">
              <view class="meta-user">
                <image wx:if="{{item.userAvatar}}" src="{{item.userAvatar}}" class="meta-avatar" />
                <view class="meta-avatar-placeholder" wx:else>{{item.userNicknameFirst || '匿'}}</view>
                <text class="meta-name">{{item.userNickname}}</text>
                <text class="meta-v" wx:if="{{item.authorVerified}}">✓</text>
              </view>
              <text class="meta-stat">❤ {{item.likeCount || 0}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 骨架屏 -->
  <view class="feed" wx:if="{{loading && leftList.length === 0 && rightList.length === 0}}">
    <view class="feed-col">
      <view class="feed-card skeleton-card" wx:for="{{[1,2]}}" wx:key="*this">
        <view class="skeleton-block card-cover-placeholder"></view>
        <view class="card-body">
          <view class="skeleton-block" style="height: 32rpx; width: 80%; margin-bottom: 16rpx;"></view>
          <view class="skeleton-block" style="height: 24rpx; width: 60%; margin-bottom: 16rpx;"></view>
          <view class="skeleton-block" style="height: 24rpx; width: 40%;"></view>
        </view>
      </view>
    </view>
    <view class="feed-col">
      <view class="feed-card skeleton-card" wx:for="{{[1,2]}}" wx:key="*this">
        <view class="skeleton-block card-cover-placeholder"></view>
        <view class="card-body">
          <view class="skeleton-block" style="height: 32rpx; width: 70%; margin-bottom: 16rpx;"></view>
          <view class="skeleton-block" style="height: 24rpx; width: 50%; margin-bottom: 16rpx;"></view>
          <view class="skeleton-block" style="height: 24rpx; width: 35%;"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{loading && leftList.length > 0}}">
    <view class="loading-dot"></view>
    <text class="load-text">加载中...</text>
  </view>
  
  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && leftList.length > 0 && !loading}}">
    <view class="no-more-line"></view>
    <text class="no-more-text">到底了</text>
    <view class="no-more-line"></view>
  </view>

  <!-- 加载失败：点击重试 -->
  <view class="empty-container" wx:if="{{loadFail && !loading && leftList.length === 0 && rightList.length === 0}}" bindtap="reloadList">
    <view class="empty-emoji">😵</view>
    <view class="empty-text">加载失败</view>
    <view class="empty-sub">点击屏幕重试</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-container" wx:elif="{{!loading && leftList.length === 0 && rightList.length === 0}}">
    <view class="empty-emoji">📭</view>
    <view class="empty-text">还没有内容</view>
    <view class="empty-sub">快来发布第一条吧</view>
  </view>
</view>

<!-- 回到顶部 -->
<view class="back-top" wx:if="{{showBackTop}}" bindtap="goBackTop">↑</view>

<!-- 悬浮发布按钮 -->
<view class="fab" bindtap="goPublish">
  <text class="fab-icon">+</text>
</view>

<!-- 发布菜单 -->
<view class="publish-mask" wx:if="{{showPublishMenu}}" bindtap="togglePublishMenu"></view>
<view class="publish-menu" wx:if="{{showPublishMenu}}">
  <view class="publish-item" data-type="post" bindtap="onPublishSelect">
    <view class="publish-item-icon">📝</view>
    <view class="publish-item-text">
      <view class="publish-item-title">发帖子</view>
      <view class="publish-item-desc">分享日常、吐槽、求助</view>
    </view>
  </view>
  <view class="publish-item" data-type="product" bindtap="onPublishSelect">
    <view class="publish-item-icon">🛒</view>
    <view class="publish-item-text">
      <view class="publish-item-title">卖东西</view>
      <view class="publish-item-desc">二手商品信息发布</view>
    </view>
  </view>
  <view class="publish-item" data-type="lostfound" bindtap="onPublishSelect">
    <view class="publish-item-icon">🎒</view>
    <view class="publish-item-text">
      <view class="publish-item-title">失物招领</view>
      <view class="publish-item-desc">丢了东西 / 捡到东西</view>
    </view>
  </view>
  <view class="publish-item" data-type="confession" bindtap="onPublishSelect">
    <view class="publish-item-icon">💌</view>
    <view class="publish-item-text">
      <view class="publish-item-title">表白墙</view>
      <view class="publish-item-desc">匿名说出心里话</view>
    </view>
  </view>
  <view class="publish-cancel" bindtap="togglePublishMenu">取消</view>
</view>

<!-- 多级分类选择器 -->
<category-picker visible="{{showCatPicker}}" bind:select="onCatSelect" bind:close="onCatClose" />
