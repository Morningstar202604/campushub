/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: 180rpx;
}

/* ===== 顶部搜索栏 ===== */
.top-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 99;
}

.top-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
  white-space: nowrap;
  letter-spacing: 1rpx;
}

.top-search {
  flex: 1;
  height: 64rpx;
  background: var(--color-bg-gray);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-placeholder {
  font-size: var(--font-size-sm);
  color: var(--color-text-placeholder);
}

.top-expired {
  flex-shrink: 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  padding: 10rpx 18rpx;
  background: var(--color-bg-gray);
  border-radius: var(--radius-full);
  white-space: nowrap;
}

/* ===== 分类筛选条 ===== */
.cat-filter {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 32rpx 0;
  padding: 18rpx 24rpx;
  background: #fff;
  border-radius: var(--radius-md);
}
.cat-filter-icon {
  font-size: 28rpx;
}
.cat-filter-text {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  font-weight: 500;
}
.cat-filter-placeholder {
  color: var(--color-text-tertiary);
  font-weight: 400;
}
.cat-filter-clear {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  white-space: nowrap;
}

/* ===== Tab 栏 ===== */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 32rpx;
  height: 80rpx;
  align-items: center;
  gap: 48rpx;
  position: sticky;
  top: 96rpx;
  z-index: 98;
  border-bottom: 1rpx solid var(--color-border-light);
}

.tab-item {
  position: relative;
  height: 100%;
  display: flex;
  align-items: center;
}

.tab-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.tab-item.active .tab-text {
  color: var(--color-text-primary);
  font-weight: 600;
  font-size: var(--font-size-md);
}

.tab-line {
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: var(--radius-full);
}

/* ===== 信息流瀑布流 ===== */
.feed {
  display: flex;
  padding: 16rpx;
  gap: 16rpx;
}

.feed-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ===== 卡片 ===== */
.feed-card {
  background: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease;
}

.feed-card:active {
  transform: scale(0.98);
}

.card-cover {
  width: 100%;
  display: block;
  background: var(--color-bg-gray);
}

.card-body {
  padding: 20rpx 24rpx 24rpx;
}

.card-title {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.45;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

/* ===== 价格行 ===== */
.card-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.card-price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-price);
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.card-original-price {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  text-decoration: line-through;
}

/* ===== 标签 ===== */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

/* ===== 卡片底部 ===== */
.card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.meta-user {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  overflow: hidden;
}

.meta-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.meta-avatar-placeholder {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.meta-name {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-stat {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  white-space: nowrap;
}

/* ===== 骨架屏 ===== */
.skeleton-card {
  pointer-events: none;
}

.card-cover-placeholder {
  width: 100%;
  height: 300rpx;
}

/* ===== 加载状态 ===== */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0;
  gap: 12rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.load-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 24rpx;
}

.no-more-line {
  width: 64rpx;
  height: 2rpx;
  background: var(--color-border);
}

.no-more-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* ===== 空状态 ===== */
.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-sub {
  font-size: var(--font-size-sm);
  color: var(--color-text-placeholder);
  margin-top: 8rpx;
}

/* ===== 悬浮按钮 ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  z-index: 99;
}

.fab-icon {
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

.fab:active {
  transform: scale(0.92);
}

/* ===== 发布菜单 ===== */
.publish-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
}

.publish-menu {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 0;
  z-index: 201;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.25s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.publish-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 24rpx;
}

.publish-item:active {
  background: var(--color-bg-hover);
}

.publish-item-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background: var(--color-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.publish-item-text {
  flex: 1;
}

.publish-item-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.publish-item-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.publish-cancel {
  margin: 16rpx 32rpx 0;
  padding: 28rpx 0;
  text-align: center;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  border-top: 1rpx solid var(--color-border-light);
}

.publish-cancel:active {
  background: var(--color-bg-hover);
}
