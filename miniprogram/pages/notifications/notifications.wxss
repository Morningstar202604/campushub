/* pages/notifications/notifications.wxss */
.notif-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 16rpx 0;
}

.notif-list {
  padding: 0 32rpx;
}

.notif-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  margin-bottom: 12rpx;
  position: relative;
}

.notif-item.unread {
  background: #F0F7FF;
}

.notif-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-danger);
  flex-shrink: 0;
  margin-top: 8rpx;
}

.notif-body {
  flex: 1;
}

.notif-content {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.notif-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.notif-type {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.notif-time {
  font-size: var(--font-size-xs);
  color: var(--color-text-quaternary);
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
  color: var(--color-text-quaternary);
  font-size: var(--font-size-xs);
}
