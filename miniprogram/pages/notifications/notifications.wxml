<!-- pages/notifications/notifications.wxml -->
<view class="notif-page">
  <view class="notif-list" wx:if="{{list.length > 0}}">
    <view class="notif-item {{!item.isRead ? 'unread' : ''}}" wx:for="{{list}}" wx:key="_id" data-item="{{item}}" bindtap="onItemTap">
      <view class="notif-dot" wx:if="{{!item.isRead}}"></view>
      <view class="notif-body">
        <view class="notif-content">{{item.content}}</view>
        <view class="notif-meta">
          <text class="notif-type">
            {{item.type === 'like' ? '👍 点赞' : item.type === 'comment' ? '💬 评论' : item.type === 'follow' ? '👥 关注' : '📢 系统'}}
          </text>
          <text class="notif-time">{{item.timeText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-container" wx:if="{{!loading && list.length === 0}}">
    <view class="empty-emoji">🔕</view>
    <view class="empty-text">暂无消息</view>
  </view>

  <view class="load-more" wx:if="{{loading}}">
    <text>加载中…</text>
  </view>
  <view class="load-more" wx:if="{{!loading && !hasMore && list.length > 0}}">
    <text>没有更多了</text>
  </view>
</view>
