<!-- pages/admin/admin.wxml — 管理员审核台 -->
<view class="admin-page">
  <view class="admin-header">
    <view class="admin-badge">🛡️ 管理员</view>
    <view class="admin-sub">待处理举报：{{total}}</view>
  </view>

  <!-- Tab 切换 -->
  <view class="admin-tabs">
    <view class="admin-tab {{activeTab === 'reports' ? 'active' : ''}}" data-key="reports" bindtap="onTabChange">举报审核</view>
    <view class="admin-tab {{activeTab === 'manage' ? 'active' : ''}}" data-key="manage" bindtap="onTabChange">帖子管理</view>
    <view class="admin-tab {{activeTab === 'users' ? 'active' : ''}}" data-key="users" bindtap="onTabChange">用户/封禁</view>
    <view class="admin-tab {{activeTab === 'verify' ? 'active' : ''}}" data-key="verify" bindtap="onTabChange">校园认证</view>
    <view class="admin-tab {{activeTab === 'announcements' ? 'active' : ''}}" data-key="announcements" bindtap="onTabChange">公告管理</view>
    <view class="admin-tab {{activeTab === 'logs' ? 'active' : ''}}" data-key="logs" bindtap="onTabChange">操作日志</view>
  </view>

  <!-- 举报审核 -->
  <block wx:if="{{activeTab === 'reports'}}">
    <view class="admin-quick">
      <view class="quick-btn" bindtap="goCategoryAdmin">📂 分类管理</view>
    </view>

    <view class="report-list">
      <view class="empty" wx:if="{{reports.length === 0 && !loading}}">暂无待处理举报 🎉</view>

      <view class="report-card" wx:for="{{reports}}" wx:key="reportId">
        <view class="report-top">
          <text class="type-tag type-{{item.targetType}}">{{item.targetType === 'post' ? '帖子' : item.targetType === 'product' ? '商品' : '评论'}}</text>
          <text class="reason">{{item.reason}}</text>
        </view>

        <view class="report-snippet" wx:if="{{!item.target.notFound}}">{{item.target.snippet}}</view>
        <view class="report-snippet notfound" wx:else>内容已不存在</view>

        <view class="report-desc" wx:if="{{item.description}}">说明：{{item.description}}</view>
        <view class="report-author" wx:if="{{item.target.ownerNickname}}">作者：{{item.target.ownerNickname}}</view>

        <view class="report-actions">
          <text class="act act-del" data-id="{{item.targetId}}" data-type="{{item.targetType}}" bindtap="onDelete">删除内容</text>
          <text class="act act-ban" wx:if="{{item.target.ownerId}}" data-ownerid="{{item.target.ownerId}}" data-nickname="{{item.target.ownerNickname}}" bindtap="onBanAuthor">封禁作者</text>
          <text class="act act-resolve" data-reportid="{{item.reportId}}" bindtap="onResolve">标记处理</text>
        </view>
      </view>

      <view class="load-more" wx:if="{{loading}}">加载中…</view>
      <view class="load-more" wx:elif="{{!hasMore && reports.length > 0}}">没有更多了</view>
    </view>
  </block>

  <!-- 帖子管理（置顶/加精） -->
  <block wx:if="{{activeTab === 'manage'}}">
    <view class="ban-panel">
      <view class="panel-title">📌 置顶 / ⭐ 加精</view>
      <view class="panel-desc">输入帖子ID（在帖子详情页右上角操作栏可见，或从举报列表复制）</view>
      <input class="ban-input" placeholder="输入帖子ID" value="{{pinTarget}}" bindinput="onPinInput" />
      <view class="ban-btns">
        <button class="btn btn-pin" loading="{{pinLoading}}" bindtap="doPin">📌 置顶</button>
        <button class="btn btn-unpin" bindtap="doUnpin">取消置顶</button>
      </view>
      <view class="ban-btns">
        <button class="btn btn-essence" bindtap="doEssence">⭐ 加精</button>
        <button class="btn btn-unessence" bindtap="doUnessence">取消加精</button>
      </view>
    </view>
  </block>

  <!-- 用户/封禁 -->
  <block wx:if="{{activeTab === 'users'}}">
    <view class="ban-panel">
      <view class="panel-title">用户封禁 / 解封</view>
      <input class="ban-input" placeholder="输入用户ID(24位)或OpenID" value="{{banTarget}}" bindinput="onBanInput" />
      <view class="ban-btns">
        <button class="btn btn-ban" loading="{{banLoading}}" bindtap="doBan">封禁</button>
        <button class="btn btn-unban" bindtap="doUnban">解封</button>
      </view>
    </view>

    <view class="admin-quick">
      <view class="quick-btn" bindtap="goCategoryAdmin">📂 分类管理</view>
    </view>
  </block>

  <!-- 校园认证审核 -->
  <block wx:if="{{activeTab === 'verify'}}">
    <view class="verify-list">
      <view class="panel-title">🎖️ 待审核申请（{{verifyTotal}}）</view>

      <view class="verify-item" wx:for="{{verifyList}}" wx:key="_id">
        <view class="verify-info">
          <view class="verify-line"><text class="verify-label">申请人</text>{{item.nickname || item.userId}}</view>
          <view class="verify-line"><text class="verify-label">学校</text>{{item.school}}</view>
          <view class="verify-line"><text class="verify-label">学号</text>{{item.studentId}}</view>
          <image src="{{item.imageFileID}}" mode="aspectFill" class="verify-img" data-url="{{item.imageFileID}}" bindtap="previewVerifyImage" />
        </view>
        <view class="verify-btns" wx:if="{{item.status === 'pending'}}">
          <button class="btn btn-pin" loading="{{item._loading}}" data-id="{{item._id}}" data-approve="{{true}}" bindtap="onVerifyReview">✅ 通过</button>
          <button class="btn btn-unban" data-id="{{item._id}}" data-approve="{{false}}" bindtap="onVerifyReview">❌ 驳回</button>
        </view>
        <view class="verify-status" wx:else>
          {{item.status === 'approved' ? '✅ 已通过' : '❌ 已驳回'}}{{item.rejectReason ? '：' + item.rejectReason : ''}}
        </view>
      </view>

      <view class="load-more" wx:if="{{verifyLoading}}">加载中…</view>
      <view class="load-more" wx:elif="{{verifyList.length === 0}}">暂无待审核申请</view>
      <view class="load-more" wx:elif="{{!verifyHasMore}}">没有更多了</view>
    </view>
  </block>

  <!-- 公告管理 -->
  <block wx:if="{{activeTab === 'announcements'}}">
    <view class="ban-panel">
      <view class="panel-title">📢 发布公告</view>
      <view class="panel-desc">公告将展示在首页顶部公告条，置顶公告优先展示</view>
      <input class="admin-input" placeholder="公告标题（≤50字）" value="{{annTitle}}" bindinput="onAnnTitleInput" />
      <textarea class="admin-textarea" placeholder="公告内容（≤1000字）" value="{{annContent}}" bindinput="onAnnContentInput" />
      <view class="switch-row">
        <text class="switch-label">置顶展示</text>
        <switch checked="{{annPinned}}" bindchange="onAnnPinnedChange" color="#4A90D9" />
      </view>
      <button class="btn btn-pin" loading="{{annLoading}}" bindtap="createAnnouncement">发布</button>
    </view>

    <view class="ban-panel">
      <view class="panel-title">已发布公告（{{announcements.length}}）</view>
      <view class="empty" wx:if="{{announcements.length === 0}}">还没有公告</view>
      <view class="report-card" wx:for="{{announcements}}" wx:key="_id">
        <view class="report-top">
          <text class="type-tag type-post">{{item.status === 'active' ? '展示中' : '已下线'}}</text>
          <text class="reason">{{item.isPinned ? '📌 ' : ''}}{{item.title}}</text>
        </view>
        <view class="report-desc">{{item.content}}</view>
        <view class="report-actions">
          <button class="btn btn-unpin" data-id="{{item._id}}" bindtap="toggleAnnouncement">{{item.status === 'active' ? '下线' : '上线'}}</button>
          <button class="btn btn-unban" data-id="{{item._id}}" bindtap="deleteAnnouncement">删除</button>
        </view>
      </view>
    </view>
  </block>

  <!-- 操作日志 -->
  <block wx:if="{{activeTab === 'logs'}}">
    <view class="ban-panel">
      <view class="panel-title">🕵️ 管理操作日志（最近 50 条）</view>
      <view class="empty" wx:if="{{!logsLoading && adminLogs.length === 0}}">暂无操作记录</view>
      <view class="load-more" wx:if="{{logsLoading}}">加载中…</view>
      <view class="report-card" wx:for="{{adminLogs}}" wx:key="_id">
        <view class="report-top">
          <text class="type-tag type-post">{{item.action}}</text>
          <text class="reason">{{item.detail && item.detail.targetId || item.detail && item.detail.targetOpenid || item.detail && item.detail.postId || item.detail && item.detail.feedbackId || item.detail && item.detail.requestId || '-'}}</text>
        </view>
        <view class="report-desc">{{item.createdAt}}</view>
      </view>
    </view>
  </block>
</view>
