/* pages/expired/expired.wxss */
.expired-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 24rpx 32rpx 60rpx;
}
.expired-tip {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: #fff7e6;
  border: 1rpx solid #ffe7ba;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}
.list-item {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.item-info { flex: 1; }
.item-title {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: 1.4;
}
.item-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.item-cat {
  background: var(--color-bg-gray);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
}
.tag-resolved {
  color: #16a34a;
  font-size: var(--font-size-sm);
  margin-right: 8rpx;
}
.empty-container {
  text-align: center;
  padding-top: 120rpx;
}
.empty-emoji { font-size: 64rpx; }
.empty-text {
  margin-top: 16rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
