<!-- pages/post-publish/post-publish.wxml -->
<view class="publish-page">
  <!-- 标题 -->
  <view class="form-section">
    <input
      class="title-input"
      placeholder="标题（必填，30字以内）"
      maxlength="30"
      value="{{title}}"
      bindinput="onTitleInput"
      cursor-spacing="20"
    />
  </view>

  <!-- 正文 -->
  <view class="form-section">
    <textarea
      class="content-input"
      placeholder="说点什么吧...（支持2000字）"
      maxlength="2000"
      value="{{content}}"
      bindinput="onContentInput"
      cursor-spacing="20"
      auto-height
    />
  </view>

  <!-- 图片 -->
  <view class="form-section">
    <view class="image-grid">
      <view class="image-item" wx:for="{{images}}" wx:key="*this" wx:for-index="idx">
        <image src="{{item}}" mode="aspectFill" class="preview-image" data-index="{{idx}}" bindtap="previewImage" />
        <view class="image-delete" data-index="{{idx}}" catchtap="removeImage">×</view>
      </view>
      <view class="image-add" wx:if="{{images.length < 9}}" bindtap="chooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">{{images.length}}/9</text>
      </view>
    </view>
  </view>

  <!-- 分类（多级目录） -->
  <view class="form-section">
    <view class="section-label">分类（选到最细，方便他人查找）</view>
    <view class="category-pick" bindtap="onCategoryTap">
      <text wx:if="{{categoryName}}" class="cat-pick-text">{{categoryName}}</text>
      <text wx:else class="cat-pick-placeholder">点击选择分区 / 吧 / 子版块</text>
      <text class="cat-pick-arrow">›</text>
    </view>
  </view>

  <!-- 类型：普通帖 / 任务帖 -->
  <view class="form-section">
    <view class="section-label">类型</view>
    <view class="kind-row">
      <view class="kind-item {{kind === 'post' ? 'active' : ''}}" data-kind="post" bindtap="onKindChange">💬 普通帖</view>
      <view class="kind-item {{kind === 'task' ? 'active' : ''}}" data-kind="task" bindtap="onKindChange">📌 任务/请求</view>
      <view class="kind-item {{kind === 'lost' ? 'active' : ''}}" data-kind="lost" bindtap="onKindChange">🔍 失物</view>
      <view class="kind-item {{kind === 'found' ? 'active' : ''}}" data-kind="found" bindtap="onKindChange">🎁 招领</view>
      <view class="kind-item {{kind === 'confession' ? 'active' : ''}}" data-kind="confession" bindtap="onKindChange">💌 表白墙</view>
    </view>
    <view class="expire-row" wx:if="{{kind === 'task'}}">
      <text class="expire-label">有效期</text>
      <view class="expire-options">
        <view
          class="expire-opt {{expireDays === item ? 'active' : ''}}"
          wx:for="{{expireOptions}}"
          wx:key="*this"
          data-days="{{item}}"
          bindtap="onExpireChange"
        >{{item}}天</view>
      </view>
      <text class="expire-tip">超时未解决将自动归档到「过期」页</text>
    </view>
  </view>

  <!-- 标签 -->
  <view class="form-section">
    <view class="section-label">话题标签（选填，最多5个）</view>
    <view class="tags-area">
      <view class="tag-item" wx:for="{{tags}}" wx:key="*this">
        <text>#{{item}}</text>
        <text class="tag-remove" data-tag="{{item}}" bindtap="removeTag">×</text>
      </view>
      <input
        class="tag-input"
        placeholder="输入标签后回车"
        value="{{tagInput}}"
        bindinput="onTagInput"
        bindconfirm="addTag"
        wx:if="{{tags.length < 5}}"
      />
    </view>
  </view>

  <!-- 失物/招领：地点 -->
  <view class="form-section" wx:if="{{kind === 'lost' || kind === 'found'}}">
    <view class="section-label">📍 地点（选填）</view>
    <input class="location-input" placeholder="如：图书馆三楼 / 东门快递站" value="{{location}}" bindinput="onLocationInput" maxlength="50" />
  </view>

  <!-- 匿名（表白墙强制匿名，隐藏开关） -->
  <view class="form-section anon-section" wx:if="{{kind !== 'confession'}}">
    <view class="anon-info">
      <view class="anon-title">匿名发布</view>
      <view class="anon-desc">匿名可发帖和评论，但不能发布商品或交易</view>
    </view>
    <switch checked="{{isAnonymous}}" bindchange="onAnonymousChange" color="#4A90D9" />
  </view>

  <!-- 提交 -->
  <view class="submit-bar safe-bottom">
    <t-button theme="primary" size="large" block bindtap="submit" loading="{{submitting}}">
      {{isEdit ? '保存修改' : '发布'}}
    </t-button>
  </view>

  <!-- 多级分类选择器 -->
  <category-picker visible="{{showCatPicker}}" bind:select="onCatSelect" bind:close="onCatClose" />
</view>
